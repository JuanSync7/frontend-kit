{
  "name": "@juansync7/bricks",
  "version": "0.1.0",
  "description": "A catalogue of real LEGO parts drawn from our own geometry, models planned as shapes and swapped into them, and checks that the result could be built: no clipping, nothing floating, every piece on the grid",
  "keywords": ["lego", "bricks", "three.js", "3d", "procedural", "model", "catalogue"],
  "license": "MIT",
  "author": "Juan Kok (https://juansync.dev)",
  "homepage": "https://github.com/JuanSync7/frontend-kit/tree/main/bricks#readme",
  "repository": { "type": "git", "url": "git+https://github.com/JuanSync7/frontend-kit.git", "directory": "bricks" },
  "bugs": { "url": "https://github.com/JuanSync7/frontend-kit/issues/new?template=bricks.yml" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "parts", "LICENSE", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --external:three --external:three/* --outfile=dist/index.js && tsc -p .",
    "check": "tsc -p . --noEmit --emitDeclarationOnly false && tsx scripts/selftest.mjs",
    "selftest": "tsx scripts/selftest.mjs",
    "reference": "tsx scripts/reference.mjs",
    "prepublishOnly": "npm run build && npm run check"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "esbuild": "^0.24.0",
    "three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "~5.5.3"
  }
}
